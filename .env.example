# Copy to .env. Node reads it automatically at startup.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
BASE_URL=http://localhost:3000
# Set true behind the HTTPS reverse proxy; false only for localhost.
COOKIE_SECURE=false
# SMTP is required for production notifications. Never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sankari IT <it@sankari-holding.com>
IT_EMAIL=saeed.dakalbab@sankari-holding.com
# Internal hourly jobs: helpdesk minute 48, email accounts minute 27 (UTC).
NOTIFIER_ENABLED=true
