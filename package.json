{
  "name": "sankari-unified-platform",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:smoke": "tsx scripts/smoke-db.ts",
    "worker": "tsx scripts/worker.ts",
    "migration:dry-run": "tsx scripts/migrate-artifacts.ts dry-run",
    "migration:commit": "tsx scripts/migrate-artifacts.ts commit",
    "migration:export-clickup": "tsx scripts/export-clickup.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@hookform/resolvers": "^5.2.2",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer10": "npm:nodemailer@^10.0.10",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.2.1",
    "tsx": "^4.20.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "engines": { "node": ">=24.0.0" }
}
