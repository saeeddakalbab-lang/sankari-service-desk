# Public application URL supplied by EasyPanel, always HTTPS in production.
NEXTAUTH_URL=https://portal.example.com
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
POSTGRES_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql://sankari:replace-me@postgres:5432/sankari

# Google Cloud OAuth client: Web application, Workspace Internal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=sankari-holding.com

# Comma-separated role assignments. Users must still authenticate with Workspace.
ADMIN_EMAILS=saeed.dakalbab@sankari-holding.com
BOARD_EMAILS=
AGENT_EMAILS=saeed.dakalbab@sankari-holding.com
DEV_EMAILS=

# SMTP notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sankari Platform <it@sankari-holding.com>
ALERT_EMAIL=saeed.dakalbab@sankari-holding.com

# Jira Cloud read-only integration.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_SERVICE_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=
JIRA_ALLOWED_EMAILS=
JIRA_POLL_MINUTES=10

# Optional: run the ClickUp exporter again without committing source data.
CLICKUP_API_TOKEN=
CLICKUP_HELPDESK_LIST_ID=901522165191
CLICKUP_EMAIL_LIST_ID=901522764966

# Security and operations.
TRUST_PROXY=true
RATE_LIMIT_POINTS=60
RATE_LIMIT_DURATION=60
BACKUP_RETENTION_DAYS=14
RCLONE_REMOTE=
# Optional rclone remote named "remote" (S3-compatible example).
RCLONE_CONFIG_REMOTE_TYPE=
RCLONE_CONFIG_REMOTE_PROVIDER=
RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_REMOTE_ENDPOINT=

# Development only; production startup refuses this value.
AUTH_DEV_BYPASS=false
